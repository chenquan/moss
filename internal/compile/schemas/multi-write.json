{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["articles", "facts"],
  "properties": {
    "articles": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/article"}},
    "facts": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/fact"}},
    "relations": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/relation"}}
  },
  "$defs": {
    "article": {"type": "object", "additionalProperties": false, "required": ["operation", "title", "slug", "summary", "body", "sensitivity", "tags", "source_ids", "citations"], "properties": {
      "operation": {"type": "string", "enum": ["create", "update", "retract"]}, "article_id": {"type": "string", "maxLength": 200}, "title": {"type": "string", "minLength": 1, "maxLength": 240}, "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,119}$"}, "summary": {"type": "string", "maxLength": 2000}, "body": {"type": "string", "maxLength": 1000000}, "sensitivity": {"type": "string", "enum": ["normal", "sensitive", "restricted"]}, "tags": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 80}}, "source_ids": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 200}}, "citations": {"type": "array", "maxItems": 500, "items": {"type": "object", "required": ["source_id", "locator"], "properties": {"source_id": {"type": "string", "maxLength": 200}, "locator": {"type": "string", "maxLength": 500}}}}
    }},
    "fact": {"type": "object", "additionalProperties": false, "required": ["operation", "fact_key", "kind", "text", "status", "source_ids"], "properties": {
      "operation": {"type": "string", "enum": ["create", "update", "retract"]}, "fact_id": {"type": "string", "maxLength": 200}, "fact_key": {"type": "string", "minLength": 1, "maxLength": 240}, "kind": {"type": "string", "minLength": 1, "maxLength": 80}, "text": {"type": "string", "maxLength": 4000}, "status": {"type": "string", "enum": ["active", "superseded", "retracted"]}, "source_ids": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "maxLength": 200}}, "extraction_id": {"type": "string", "maxLength": 200}, "supersedes_fact_id": {"type": "string", "maxLength": 200}, "review_after": {"type": "string", "maxLength": 80}
    }},
    "relation": {"type": "object", "additionalProperties": false, "required": [], "properties": {
      "relation_type": {"type": "string", "enum": ["supports", "contradicts", "supersedes", "depends_on", "produces", "resulted_in"]},
      "type": {"type": "string", "enum": ["supports", "contradicts", "supersedes", "depends_on", "produces", "resulted_in"]},
      "from": {"$ref": "#/$defs/endpoint"}, "to": {"$ref": "#/$defs/endpoint"},
      "from_type": {"type": "string", "enum": ["source", "fact", "article", "action", "action_result"]}, "from_id": {"type": "string", "maxLength": 240}, "from_version": {"type": "integer", "minimum": 0, "maximum": 1000000000},
      "from_revision": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "to_type": {"type": "string", "enum": ["source", "fact", "article", "action", "action_result"]}, "to_id": {"type": "string", "maxLength": 240}, "to_version": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "to_revision": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "source_id": {"type": "string", "maxLength": 240}
    }},
    "endpoint": {"type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": {"type": {"type": "string", "enum": ["source", "fact", "article", "action", "action_result"]}, "id": {"type": "string", "minLength": 1, "maxLength": 240}, "version": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "revision": {"type": "integer", "minimum": 0, "maximum": 1000000000}}}
  }
}
